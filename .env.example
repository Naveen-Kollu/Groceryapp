# Copy this file to .env and add the values from your Supabase project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=replace-this-with-a-long-random-secret
# Set true when serving the app over HTTPS.
COOKIE_SECURE=true

# Optional order confirmation email. Use Brevo's HTTPS API on Render Free.
# The sender address must be verified in your Brevo account.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# Used as the sender address for both SMTP and Brevo.
SMTP_FROM_EMAIL=your-test-account@gmail.com

# SMTP is supported for local development and non-Render-Free hosting.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use your Gmail address and a Google App Password, not your normal password.
SMTP_USERNAME=your-test-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_USE_SSL=false

# Optional Twilio SMS order confirmations. Customers must explicitly opt in at checkout.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
